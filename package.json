{
  "name": "iterasys-automacao",
  "version": "1.0.0",
  "private": true,
  "description": "Automação de casos de teste e critérios de aceitação - plataforma Iterasys",
  "scripts": {
    "test": "playwright test --project=chromium",
    "test:headed": "playwright test --headed --project=chromium",
    "test:firefox": "playwright test --project=firefox",
